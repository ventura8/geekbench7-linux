# openSUSE RPM packaging image — Leap 16.0
FROM opensuse/leap:16.0

ENV LANG=C.UTF-8
RUN zypper --non-interactive refresh \
    && zypper --non-interactive install -y --no-recommends \
        AppStream \
        binutils \
        desktop-file-utils \
        file \
        findutils \
        gcc \
        git \
        glibc-devel \
        gzip \
        meson \
        ninja \
        python3 \
        rpm-build \
        rpmlint \
        tar \
        util-linux \
    && zypper clean -a
WORKDIR /src
USER 65534:65534
CMD ["./scripts/release-rpm.sh", "opensuse"]
