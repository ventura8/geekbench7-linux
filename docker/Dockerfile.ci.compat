# Compat/unit test image (generic)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --only-binary=:all: 'pytest==8.3.3'
WORKDIR /src
USER 65534:65534
CMD ["/bin/bash"]
