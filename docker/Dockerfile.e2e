# Real Geekbench E2E (network) — run only in CI/hardware QA containers
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        python3-pip \
        tar \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --only-binary=:all: 'pytest==9.1.1'
WORKDIR /src
USER 65534:65534
CMD ["/bin/bash"]
