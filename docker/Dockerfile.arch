# Arch Linux packaging image
FROM archlinux:base-devel

RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed \
        appstream \
        binutils \
        desktop-file-utils \
        file \
        git \
        meson \
        ninja \
        python \
    && pacman -Scc --noconfirm \
    && useradd -m builder
WORKDIR /src
USER builder
CMD ["./scripts/release-arch.sh"]
