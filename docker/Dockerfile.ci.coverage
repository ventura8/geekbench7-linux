# Coverage stage image
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --only-binary=:all: \
        'pytest==8.3.3' \
        'pytest-cov==5.0.0'
WORKDIR /src
USER 65534:65534
CMD ["/bin/bash"]
