<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>@APP_NAME@</name>
  <summary>Unofficial packaging for official Geekbench 7 on Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.ventura8">
    <name>ventura8</name>
  </developer>
  <description>
@DESCRIPTION@
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/ventura8/geekbench7-linux</url>
  <url type="bugtracker">https://github.com/ventura8/geekbench7-linux/issues</url>
  <categories>
    <category>System</category>
    <category>Monitor</category>
  </categories>
  <provides>
    <binary>geekbench7-linux</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="2026-10-16"/>
  </releases>
</component>
