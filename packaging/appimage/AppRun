#!/bin/sh
# AppRun for geekbench7-linux AppImage (wrapper only; Geekbench downloaded per-user).
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:${PATH:-}"
export GEEKBENCH7_LINUX_LIBDIR="$HERE/usr/share/geekbench7-linux"
exec "$HERE/usr/bin/python3" -I "$HERE/usr/bin/geekbench7-linux" "$@"
